# Copy to .env (never commit .env). Only the server reads these.
NVIDIA_API_KEY=
# Optional
# NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NIM_FALLBACK_MODEL=minimaxai/minimax-m3.1-flash   # empty = no fallback
# NIM_EMBED_MODEL=nvidia/nemotron-3.5-embed-1b   # change it, then run npm run embeddings
# EMBED_TIMEOUT_MS=3000                 # past this, retrieval falls back to BM25 only
# PORT=8000
# HOST=127.0.0.1
# ALLOWED_ORIGINS=https://example.com   # when the site and the API live on different hosts
# RATE_LIMIT=20                         # questions per IP per 10 minutes
# TRUST_PROXY=1                         # behind a reverse proxy, use X-Forwarded-For
# SERVE_STATIC=0                        # API only
